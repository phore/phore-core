{
  "name": "phore/core",
  "description": "Phore core library",
  "license": "MIT",
  "homepage": "https://infracamp.org/project/phore",
  "authors": [
    { "name": "Matthias Leuffen", "email": "m@tth.es" }
  ],
  "repositories": [
  ],
  "require": {
    "php": ">=8.0"
  },
  "suggest": {
    "ext-yaml": "Yaml encoding parsing",
    "ext-sodium": "Encryption functions",
    "ext-json": "Json encoding parsing"
  },
  "autoload": {
    "psr-4": {
      "Phore\\Core\\": "src/"
    },
    "files": [
      "src/functions.inc.php"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "8.2.0"
    }
  },
  "require-dev": {
    "phpspec/phpspec": "^8.3",
    "ext-yaml": "*",
    "ext-sodium": "*",
    "ext-json": "*"
  },
  "scripts": {
    "test": "@php -d error_reporting=-1 vendor/bin/phpspec run --no-interaction"
  }
}
